{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "nonabbocco",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "json",
          "path": "manifest.json",
          "jsonpath": "$.version"
        }
      ]
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Novità" },
    { "type": "fix", "section": "Correzioni" },
    { "type": "perf", "section": "Prestazioni" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "docs", "section": "Documentazione" },
    { "type": "test", "section": "Test", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Manutenzione", "hidden": true }
  ]
}
