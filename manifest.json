{
  "manifest_version": 3,
  "name": "NonAbbocco - Difesa Anti-Phishing & Ranking",
  "version": "1.0.0",
  "description": "Scansiona in tempo reale URL e DOM, calcola un ranking di rischio 1-5 e impedisce di abboccare alle esche phishing.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "NonAbbocco Defender",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nonabbocco@saveriomenin.it",
      "strict_min_version": "115.0"
    }
  }
}
